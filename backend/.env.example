# Copy this file to .env and adjust values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=coms_db
DB_CONNECTION_LIMIT=10

# Backups (npm run backup). Point BACKUP_DIR at an external drive or a synced
# cloud folder -- a backup on the same disk as the database is lost with it.
# BACKUP_DIR=D:/COMS-backups
# BACKUP_KEEP=30

# Session auth -- how long a signed-in session stays valid. Sliding: an
# active session's expiry is pushed out on every request (see
# authenticate.js), so this is really "how long an idle session survives".
SESSION_EXPIRES_IN=7d

# CORS - Angular dev server origin(s), comma-separated. Add your LAN address
# alongside localhost so phones scanning a receipt QR are allowed through.
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,http://192.168.1.11:4200

# Seed defaults (only used by database/seed.js on first run)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MASTER_ADMIN_USERNAME=masteradmin
SEED_MASTER_ADMIN_PASSWORD=MasterAdmin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Base URL used in the receipt QR code. Point this at an address a phone can
# reach (e.g. http://192.168.1.20:4200 on a LAN, or your public hostname).
PUBLIC_APP_URL=http://localhost:4200

# WebAuthn (biometric / passkey sign-in).
# NOTE: browsers only expose WebAuthn in a secure context -- that means HTTPS,
# or plain-HTTP localhost. Biometric sign-in therefore works at
# http://localhost:4200 but NOT at a plain-HTTP LAN address; serve over HTTPS
# to enable it there.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Church Office Management System
WEBAUTHN_ORIGIN=http://localhost:4200
