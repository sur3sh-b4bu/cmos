# Copy this file to .env and adjust values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=coms_db
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_before_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_before_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Angular dev server origin
CORS_ORIGIN=http://localhost:4200

# Seed defaults (only used by database/seed.js on first run)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
