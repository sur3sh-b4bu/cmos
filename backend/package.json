{
  "name": "coms-backend",
  "version": "1.0.0",
  "description": "Church Office Management System - REST API backend (Node.js + Express + MySQL)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "seed:mock": "node scripts/seed-mock-data.js",
    "sync:db": "node scripts/sync-client-db.js",
    "db:setup": "npm run migrate && npm run seed",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "fonts:extract": "node scripts/extractFonts.js",
    "postinstall": "node scripts/extractFonts.js",
    "test": "jest --runInBand",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "test:matrix": "node scripts/test-matrix.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7",
    "pdfmake": "^0.2.10",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
